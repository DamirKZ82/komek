# Скопируйте в .env и подставьте свои значения.
ENVIRONMENT=local
DEBUG=true
DATABASE_URL=postgresql+asyncpg://komek:komek@localhost:5432/komek
JWT_SECRET=dev-secret-change-me
# В local/staging код входа фиксированный, SMS не шлётся.
OTP_DEBUG_CODE=111111
CORS_ORIGINS=*

# --- Внешние интеграции ---
# Все пустые значения означают режим разработки: заглушка вместо провайдера.
# Заглушки платежей и KYC запрещены в production — приложение откажется их использовать.

# Эквайринг: см. docs/payments-integration.md
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_URL=

# KYC (liveness + удостоверение), например Verigram
KYC_API_URL=
KYC_API_KEY=

# SMS-шлюз РК (Mobizon/SMSC и т.п.)
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=Komek

# S3-совместимое хранилище: документы верификации и медиа
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_DOCUMENTS_BUCKET=komek-documents
S3_MEDIA_BUCKET=komek-media
